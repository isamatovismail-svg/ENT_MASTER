# Оповещение «служба не работает» главному администратору в Telegram.
# Вызывается через OnFailure= других служб: ent-master-alert@ent-master-site.service и т. п.
[Unit]
Description=ENT MASTER — оповещение о сбое %i

[Service]
Type=oneshot
User=ent
Group=ent
WorkingDirectory=/opt/ent-master
ExecStart=/usr/bin/python3 -m server.notify failed %i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ent-master
