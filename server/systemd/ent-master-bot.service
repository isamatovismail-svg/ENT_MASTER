[Unit]
Description=ENT MASTER — Telegram-бот
After=network-online.target ent-master-site.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=ent-master-alert@%n.service

[Service]
Type=simple
User=ent
Group=ent
WorkingDirectory=/opt/ent-master
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ent-master/run.py bot
Restart=on-failure
ExecStopPost=/usr/bin/python3 -m server.notify stopped %n
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ent-master

[Install]
WantedBy=multi-user.target
