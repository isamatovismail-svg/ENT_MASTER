[Unit]
Description=ENT MASTER — сайт подготовки к ЕНТ
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=ent-master-alert@%n.service

[Service]
Type=simple
User=ent
Group=ent
WorkingDirectory=/opt/ent-master
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ent-master/run.py site
Restart=on-failure
ExecStopPost=/usr/bin/python3 -m server.notify stopped %n
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ent-master /var/backups/ent-master

[Install]
WantedBy=multi-user.target
