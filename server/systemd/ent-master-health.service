# Проверка «сайт отвечает»: если процесс жив, но завис, systemd этого не заметит.
# После двух неудачных проверок подряд — сообщение в Telegram, после восстановления — ещё одно.
[Unit]
Description=ENT MASTER — проверка, что сайт отвечает

[Service]
Type=oneshot
User=ent
Group=ent
WorkingDirectory=/opt/ent-master
ExecStart=/usr/bin/python3 -m server.notify healthcheck
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ent-master
