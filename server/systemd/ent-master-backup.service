[Unit]
Description=ENT MASTER — резервная копия базы SQLite
OnFailure=ent-master-alert@%n.service

[Service]
Type=oneshot
User=ent
Group=ent
WorkingDirectory=/opt/ent-master
ExecStart=/usr/bin/python3 -m server.backup --telegram
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ent-master /var/backups/ent-master
TimeoutStartSec=10min
