# Скопируйте этот файл в .env и впишите токен бота от @BotFather.
# Файл .env не попадает в git (он в .gitignore).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Адрес сайта для ссылок входа из бота (по умолчанию http://localhost:8000).
# SITE_URL=https://ent-master.example.kz

# Почта для кодов подтверждения и восстановления пароля (Gmail: SMTP с SSL на порту 465).
# SMTP_PASSWORD — «пароль приложения» Google (не обычный пароль от почты).
# Если SMTP не настроен, письма с кодами печатаются в консоль сервера.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=ent.master@gmail.com
# SMTP_PASSWORD=abcdabcdabcdabcd
# MAIL_FROM=ENT MASTER <ent.master@gmail.com>

# Вход через Google: ключи OAuth-клиента (Google Cloud Console → Credentials → Web application).
# Без них кнопка «Войти через Google» неактивна.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
