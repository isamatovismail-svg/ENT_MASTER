# Caddy — HTTPS-прокси перед сайтом. Сертификат Let's Encrypt Caddy получает и продлевает сам.
# deploy/setup.sh подставляет домен вместо ent-master.example.kz и кладёт файл в /etc/caddy/Caddyfile.
ent-master.example.kz {
	encode gzip
	reverse_proxy 127.0.0.1:8000
	header Strict-Transport-Security "max-age=31536000"
	# Тело запроса больше 2 МБ сайт всё равно отклонит (MAX_REQUEST_BODY_BYTES).
	request_body {
		max_size 3MB
	}
}
