# Telegram-бот ENT MASTER (long polling). Включается, только если в .env есть TELEGRAM_BOT_TOKEN.
[Unit]
Description=ENT MASTER — Telegram-бот
After=network-online.target ent-master-site.service
Wants=network-online.target
# Если служба падает 5 раз за 10 минут, systemd перестаёт её перезапускать —
# тогда главному администратору уходит оповещение «не работает» (ent-master-alert@).
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=ent-master-alert@%n.service

[Service]
Type=simple
User=ent
Group=ent
WorkingDirectory=/opt/ent-master
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ent-master/bot.py
Restart=on-failure
# После каждой остановки: если это сбой, а не обычная остановка, — сообщение в Telegram.
ExecStopPost=/usr/bin/python3 /opt/ent-master/notify.py stopped %n
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ent-master

[Install]
WantedBy=multi-user.target
